/* ============================================================
   REEF RUN — in-round screen (RoundScreen.cs)
   Role intro / wall-lifted banner, exit marker, teammate and task
   markers, break-free, spectate bar and the end-of-round results.
   Same look as the menus and HUD: opaque blocks whose edges lean
   like the italic type (ReefSlab), a loud block in the role's colour
   for the headline, navy for everything else. The results use the
   main menu's skeleton. Variables don't cross UIDocuments, so the
   ones used here are redeclared on the root.
   Type sizes: 18 / 22 / 30 / 44 / 56 / 84 / 190.
   ============================================================ */

.rs-root {
    --navy: #051729; --teal: #179499; --teal-l: #2cc3c4; --orange: #ffb84d; --shark: #ff6b6b; --amber: #e6b333;
    --text: #eef6f7; --dim: #8fb0bb;
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    color: var(--text); font-size: 18px;
    -unity-font-definition: url("../UI Toolkit/Fonts/Barlow-Regular.ttf");
}
/* this reset outranks a single class, so Label rules that set a margin or padding carry the .rs-root prefix */
.rs-root Label { padding: 0; margin: 0; }

/* ---------- ReefSlab blocks (ReefSlab.cs). Set these on the slab's own classes; keep this rule first ---------- */
.slab { --slab-color: #051729; --slab-lean: 0.21; --slab-left: 1; --slab-right: 1; --slab-notch: 0; }

/* ---------- banner: the headline on a block in the role's colour, the goal on navy under it ---------- */
.rs-banner { position: absolute; left: 0; right: 0; top: 17%; align-items: center; opacity: 0; }
.rs-banner-loud { --slab-color: #2cc3c4; padding: 0 44px; }
.rs-banner.fish .rs-banner-loud { --slab-color: #2cc3c4; }
.rs-banner.shark .rs-banner-loud { --slab-color: #ff6b6b; }
.rs-banner.alert .rs-banner-loud { --slab-color: #ffb84d; }
.rs-eyebrow { font-size: 84px; letter-spacing: 1px; color: var(--navy); -unity-text-align: middle-center;
              -unity-font-definition: url("../UI Toolkit/Fonts/BarlowCondensed-ExtraBoldItalic.ttf"); }
.rs-banner-body { padding: 10px 40px 12px 40px; align-items: center; margin-top: 4px; }
.rs-title { font-size: 30px; letter-spacing: 2px; color: var(--text); -unity-text-align: middle-center;
            -unity-font-definition: url("../UI Toolkit/Fonts/BarlowCondensed-ExtraBold.ttf"); }
.rs-sub { font-size: 18px; color: var(--dim); -unity-text-align: middle-center; }

/* ---------- exit marker ---------- */
.rs-marker { position: absolute; align-items: center; translate: -50% -50%; }
.rs-diamond { width: 16px; height: 16px; rotate: 45deg; background-color: var(--orange); margin-bottom: 8px; }
.rs-marker-slab { --slab-color: #ffb84d; padding: 1px 14px; }
.rs-marker-label { font-size: 18px; letter-spacing: 2px; color: var(--navy);
                   -unity-font-definition: url("../UI Toolkit/Fonts/BarlowCondensed-Bold.ttf"); }

/* ---------- fish teammates ---------- */
.rs-ally-layer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.rs-ally { position: absolute; align-items: center; translate: -50% -100%; }
.rs-ally-pip { width: 12px; height: 12px; rotate: 45deg; background-color: var(--teal-l); margin-bottom: 7px; }
.rs-ally-slab { padding: 1px 14px; flex-direction: row; align-items: center; }
.rs-ally-name { font-size: 18px; letter-spacing: 1px; color: var(--teal-l);
                -unity-font-definition: url("../UI Toolkit/Fonts/BarlowCondensed-Bold.ttf"); }
.rs-root .rs-ally-distance { font-size: 18px; color: var(--text); margin-left: 10px;
                             -unity-font-definition: url("../UI Toolkit/Fonts/BarlowCondensed-Bold.ttf"); }
.rs-ally.edge { translate: -50% -50%; }
.rs-ally.edge .rs-ally-pip { width: 15px; height: 15px; }
.rs-ally.caught .rs-ally-pip { background-color: var(--shark); }
.rs-ally.caught .rs-ally-slab { --slab-color: #ff6b6b; }
.rs-ally.caught .rs-ally-name { color: var(--navy); }
.rs-root .rs-ally.caught .rs-ally-distance { color: var(--navy); }

/* ---------- tasks this fish tagged ---------- */
.rs-tag-layer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.rs-tag { position: absolute; align-items: center; translate: -50% -50%; }
.rs-tag-diamond { width: 14px; height: 14px; rotate: 45deg; background-color: var(--text); margin-bottom: 8px; }
.rs-tag-slab { --slab-color: #eef6f7; padding: 1px 14px; }
.rs-tag-label { font-size: 18px; letter-spacing: 2px; color: var(--navy);
                -unity-font-definition: url("../UI Toolkit/Fonts/BarlowCondensed-Bold.ttf"); }
.rs-tag.edge .rs-tag-diamond { width: 17px; height: 17px; }

/* ---------- spectating ---------- */
.rs-spectate { position: absolute; left: 0; right: 0; bottom: 5%; align-items: center; }
.rs-spectate-card { padding: 8px 44px 10px 44px; align-items: center; }
.rs-spec-eyebrow { font-size: 18px; letter-spacing: 3px; color: var(--dim);
                   -unity-font-definition: url("../UI Toolkit/Fonts/BarlowCondensed-Bold.ttf"); }
.rs-spec-name { font-size: 30px; color: var(--text); -unity-font-definition: url("../UI Toolkit/Fonts/BarlowCondensed-ExtraBold.ttf"); }
.rs-spec-hint { font-size: 18px; color: var(--dim); }

/* ---------- caught: break free ---------- */
.rs-struggle { position: absolute; left: 0; right: 0; top: 55%; align-items: center; }
.rs-struggle-loud { --slab-color: #ff6b6b; padding: 0 36px; }
.rs-struggle-title { font-size: 56px; letter-spacing: 1px; color: var(--navy);
                     -unity-font-definition: url("../UI Toolkit/Fonts/BarlowCondensed-ExtraBoldItalic.ttf"); }
.rs-struggle-keys { flex-direction: row; align-items: center; margin-top: 10px; }
.rs-root .rs-struggle-key { font-size: 30px; letter-spacing: 2px; color: var(--text); margin-right: 12px; text-shadow: 0 2px 6px rgba(0, 0, 0, 0.9);
                            -unity-font-definition: url("../UI Toolkit/Fonts/BarlowCondensed-ExtraBold.ttf"); }
/* key tile, like the HUD's */
.rs-root .rs-key { min-width: 32px; height: 32px; padding: 0 10px; border-radius: 7px; background-color: var(--teal); color: var(--orange);
                   font-size: 18px; -unity-text-align: middle-center;
                   -unity-font-definition: url("../UI Toolkit/Fonts/BarlowCondensed-ExtraBold.ttf"); }
.rs-struggle-bar { width: 540px; height: 30px; margin-top: 12px; border-width: 4px; border-color: #051729; background-color: #051729;
                   transition: scale 0.06s ease-out; }
.rs-struggle.pressed .rs-struggle-bar { scale: 1.04 1.2; }
.rs-struggle-fill { height: 22px; width: 0%; background-color: var(--teal-l); }
.rs-struggle-time { width: 540px; height: 6px; margin-top: 6px; background-color: #051729; }
.rs-struggle-time-fill { height: 6px; width: 100%; background-color: var(--shark); }
.rs-struggle-note { padding: 4px 26px; margin-top: 10px; }
.rs-struggle-sub { font-size: 18px; color: var(--text); }

/* ---------- results ---------- */
.rs-results { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(3, 16, 24, 0.84);
              opacity: 0; transition: opacity 0.6s ease-out; }
.rs-results.shown { opacity: 1; }

/* which side won (top left), whether you did, and the tally */
.rs-top { position: absolute; left: 72px; top: 36px; align-items: flex-start; }
.rs-res-title { font-size: 190px; letter-spacing: -2px; color: var(--text);
                -unity-font-definition: url("../UI Toolkit/Fonts/BarlowCondensed-ExtraBoldItalic.ttf"); }
.rs-res-title.fish { color: var(--teal-l); }
.rs-res-title.shark { color: var(--shark); }
.rs-res-line { flex-direction: row; align-items: center; margin-top: -26px; }
.rs-res-you-slab { padding: 0 26px; }
.rs-res-you-slab.won { --slab-color: #ffb84d; }
.rs-res-you-slab.lost { --slab-color: #ff6b6b; }
.rs-res-you { font-size: 44px; letter-spacing: 1px; color: var(--navy);
              -unity-font-definition: url("../UI Toolkit/Fonts/BarlowCondensed-ExtraBold.ttf"); }
.rs-root .rs-res-sub { font-size: 30px; letter-spacing: 1px; color: var(--text); margin-left: 22px;
                       -unity-font-definition: url("../UI Toolkit/Fonts/BarlowCondensed-Bold.ttf"); }

/* who ended up where: plain lists under a heading, on one navy block out of the left edge */
.rs-board { --slab-left: 0; position: absolute; left: -40px; top: 392px; padding: 22px 110px 24px 112px; }
.rs-columns { flex-direction: row; }
.rs-col { min-width: 250px; margin-right: 40px; }
.rs-root .rs-col-head { font-size: 22px; letter-spacing: 2px; margin-bottom: 6px; color: var(--dim);
                        -unity-font-definition: url("../UI Toolkit/Fonts/BarlowCondensed-Bold.ttf"); }
.rs-root .rs-col.escaped .rs-col-head { color: var(--teal-l); }
.rs-root .rs-col.eaten .rs-col-head { color: var(--shark); }
.rs-root .rs-col.died .rs-col-head { color: var(--amber); }
.rs-row { flex-direction: row; align-items: center; }
.rs-dot { display: none; }
.rs-row-name { font-size: 30px; color: var(--text); -unity-font-definition: url("../UI Toolkit/Fonts/BarlowCondensed-ExtraBold.ttf"); }
.rs-empty { font-size: 18px; color: var(--dim); }
.rs-root .rs-shark-line { margin-top: 18px; font-size: 22px; letter-spacing: 2px; color: var(--dim);
                          -unity-font-definition: url("../UI Toolkit/Fonts/BarlowCondensed-Bold.ttf"); }
.rs-root .rs-left-line { margin-top: 4px; font-size: 18px; color: var(--dim); }

/* what next (bottom left): the main menu's nav. It starts past the screen edge so the hover lunge never opens a gap */
.rs-nav { position: absolute; left: -40px; bottom: 52px; align-items: flex-start; }
.rs-root .rs-nav .rs-btn-primary, .rs-root .rs-nav .rs-btn-primary:hover, .rs-root .rs-nav .rs-btn-primary:active, .rs-root .rs-nav .rs-btn-primary:focus {
    background-color: rgba(0, 0, 0, 0); border-width: 0; border-radius: 0; margin: 0; padding: 0;
    flex-direction: row; transition: translate 0.14s ease-out-cubic; }
.rs-root .rs-nav .rs-btn-primary:hover, .rs-root .rs-nav .rs-btn-primary:focus { translate: 14px 0; }
.rs-root .rs-nav .rs-btn-primary:active { translate: 6px 0; }
.rs-primary-slab { --slab-color: #ffb84d; --slab-left: 0; --slab-notch: 30; padding: 6px 86px 6px 112px; }
.rs-btn-primary:hover .rs-primary-slab, .rs-btn-primary:focus .rs-primary-slab { --slab-color: #ffd08a; }
.rs-primary-label { font-size: 84px; letter-spacing: 1px; color: var(--navy);
                    -unity-font-definition: url("../UI Toolkit/Fonts/BarlowCondensed-ExtraBold.ttf"); }
.rs-buttons { --slab-left: 0; flex-direction: row; align-items: center; height: 66px; margin-top: 6px; padding: 0 44px 0 94px; }
.rs-root .rs-nav .rs-btn, .rs-root .rs-nav .rs-btn:hover, .rs-root .rs-nav .rs-btn:active, .rs-root .rs-nav .rs-btn:focus {
    background-color: rgba(0, 0, 0, 0); border-width: 0; border-radius: 0; margin: 0; padding: 0 18px; height: 66px;
    color: var(--text); font-size: 30px; letter-spacing: 2px;
    -unity-font-definition: url("../UI Toolkit/Fonts/BarlowCondensed-ExtraBoldItalic.ttf"); transition: color 0.1s ease; }
.rs-root .rs-nav .rs-buttons .rs-btn:hover, .rs-root .rs-nav .rs-buttons .rs-btn:focus { color: var(--orange); }
.rs-root .rs-nav .rs-buttons .rs-btn:active { color: #ffd08a; }
.rs-root .rs-wait { font-size: 18px; color: var(--dim); margin: 12px 0 0 112px; }

/* ---------- buttons from the approved UI kit: selected = lighter with a thin frame, pressed = darker and a touch smaller ---------- */
.rs-btn-primary:hover .rs-primary-slab, .rs-btn-primary:focus .rs-primary-slab, .rs-btn-primary.pad-focus .rs-primary-slab { --slab-outline: #ffb84d; --slab-outline-width: 4; }
.rs-root .rs-nav .rs-btn-primary:active { scale: 0.97 0.97; }
.rs-btn-primary:active .rs-primary-slab { --slab-color: #d9952f; --slab-outline: rgba(0, 0, 0, 0); }
.rs-root .rs-nav .rs-buttons .rs-btn.pad-focus { color: var(--orange); }
