/* ============================================================
   REEF RUN — in-game HUD (laid out in MatchHud.uxml - edit both in the UI Builder)
   Same look as the main menu: opaque navy blocks whose edges lean like
   the italic type (ReefSlab), flush to the screen edge where they sit
   against one. No outlined or see-through panels.
   Each reading has its own form: health is a chunky segmented bar,
   hunger a thin one, the clock a draining line under big numerals, a
   shark cooldown fills its whole row, a held task a framed bar.
   Palette: navy #051729, teal #179499 key tiles with orange #ffb84d
   glyphs, health #d94040, hunger #e6b333. Authored at 1920x1080
   (HudPanelSettings scales). Type sizes: 18 / 22 / 30 / 56.
   ============================================================ */

:root {
    --navy: #051729;
    --teal: #179499;
    --teal-l: #2cc3c4;
    --orange: #ffb84d;
    --red: #d94040;
    --shark: #ff6b6b;
    --amber: #e6b333;
    --text: #eef6f7;
    --dim: #8fb0bb;
    --track: rgba(143, 176, 187, 0.16);
}

.hud { position: absolute; left: 0; top: 0; right: 0; bottom: 0; color: var(--text); font-size: 18px;
       -unity-font-definition: url("../../Fonts/Barlow-Regular.ttf"); }
/* This reset outranks a single class, so a Label rule that sets a margin or padding carries the .hud prefix. */
.hud Label { padding: 0; margin: 0; }
.xb  { -unity-font-definition: url("../../Fonts/BarlowCondensed-ExtraBold.ttf"); }
.xbi { -unity-font-definition: url("../../Fonts/BarlowCondensed-ExtraBoldItalic.ttf"); }
.cb  { -unity-font-definition: url("../../Fonts/BarlowCondensed-Bold.ttf"); }
.sb  { -unity-font-definition: url("../../Fonts/Barlow-SemiBold.ttf"); }

/* ---------- ReefSlab blocks (ReefSlab.cs). Set these on the slab's own classes; keep these rules first ---------- */
.slab { --slab-color: #051729; --slab-lean: 0.21; --slab-left: 1; --slab-right: 1; --slab-notch: 0; }
.slab--from-left { --slab-left: 0; }     /* comes out of the screen's left edge */
.slab--from-right { --slab-right: 0; }   /* ... or its right edge */
.slab--orange { --slab-color: #ffb84d; }

/* key tile, like the reef-puzzle arrows */
.hud .key { min-width: 32px; height: 32px; padding: 0 8px; margin: 0 12px; border-radius: 7px; background-color: var(--teal);
            color: var(--orange); font-size: 18px; -unity-text-align: middle-center;
            -unity-font-definition: url("../../Fonts/BarlowCondensed-ExtraBold.ttf"); }

.hidden { display: none; }

/* ---------- survival clock (top centre): what's happening, the time, and a line that drains ---------- */
.clock { position: absolute; top: 24px; left: 50%; translate: -50% 0; flex-direction: row; align-items: center;
         height: 76px; padding: 0 34px 6px 34px; }
.hud .clock-label { font-size: 22px; letter-spacing: 2px; color: var(--orange); margin-right: 16px; }
/* min-width: the digits aren't all one width, and the block shouldn't twitch every second */
.clock-time { font-size: 56px; letter-spacing: 1px; min-width: 128px; }
.clock-time--low { color: var(--red); }
.clock-bar { position: absolute; left: 34px; right: 34px; bottom: 9px; height: 4px; background-color: var(--track); }
.clock-fill { height: 4px; width: 100%; background-color: var(--teal-l); }
.clock-fill--low { background-color: var(--red); }

/* ---------- world event (under the clock): an orange alert ---------- */
.event { position: absolute; top: 108px; left: 50%; translate: -50% 0; padding: 4px 26px; }
.event-text { font-size: 22px; letter-spacing: 2px; color: var(--navy); -unity-text-align: middle-center; }

/* ---------- full-screen flashes (MatchHud fades them in and out) ---------- */
.overlay { position: absolute; left: 0; top: 0; right: 0; bottom: 0; opacity: 0; }
.hurt-vignette { -unity-background-image-tint-color: rgb(217, 13, 10); }   /* hurt: red in from the edges */
.white-pop { background-color: white; }                                     /* tearing free */

/* ---------- vitals (out of the left edge; starts past it so the hit shake never opens a gap) ---------- */
.vitals { position: absolute; left: -24px; bottom: 40px; width: 470px; padding: 12px 50px 12px 64px; }
.vrow { flex-direction: row; align-items: center; height: 34px; }
.vlabel { width: 96px; font-size: 18px; letter-spacing: 2px; color: var(--dim); }
.vlabel--alert { color: var(--red); }
.vbar { flex-grow: 1; background-color: var(--track); }
.vval { width: 62px; font-size: 22px; -unity-text-align: middle-right; }
/* health: tall, cut into ten blocks by navy dividers drawn over the fill */
.vbar--health { height: 18px; }
.vfill--health { height: 18px; width: 100%; background-color: var(--red); }
.vsegs { position: absolute; left: 0; top: 0; right: 0; bottom: 0; flex-direction: row; }
.vseg { flex-grow: 1; flex-basis: 0; border-right-width: 3px; border-right-color: #051729; }
/* hunger: one thin line */
.vbar--hunger { height: 8px; }
.vfill--hunger { height: 8px; width: 100%; background-color: var(--amber); }

/* ---------- voice (out of the right edge): the whole block changes colour with its state ---------- */
.voice { position: absolute; right: -24px; bottom: 40px; flex-direction: row; align-items: center; height: 52px;
         padding: 0 64px 0 30px; }
.hud .voice-label { font-size: 18px; letter-spacing: 2px; color: var(--dim); margin-left: 10px; }
.voice--talking { --slab-color: #0c4450; }
.hud .voice--talking .voice-label { color: var(--teal-l); }
.hud .voice--off .voice-label { color: var(--amber); }
.voice--heard { --slab-color: #5e1219; }
.hud .voice--heard .voice-label { color: var(--shark); }
.voice--heard-blink { --slab-color: #d94040; }
.hud .voice--heard-blink .voice-label { color: #ffffff; }

/* ---------- shark abilities (above voice): the cooldown fills the row behind its key and name ---------- */
.abilities { position: absolute; right: -24px; bottom: 102px; width: 300px; padding: 8px 64px 8px 36px; }
.arow { flex-direction: row; align-items: center; height: 40px; margin: 2px 0; opacity: 0.55; }
.arow--ready { opacity: 1; }
.abar { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: var(--track); }
.afill { height: 40px; width: 100%; background-color: rgba(255, 107, 107, 0.4); }
.arow--ready .afill { background-color: var(--shark); }
.hud .akey { margin: 0 12px 0 6px; }
.alabel { font-size: 18px; letter-spacing: 2px; color: var(--text); }
.arow--ready .alabel { color: var(--navy); }

/* ---------- prompt + progress (lower centre) ---------- */
.prompt { position: absolute; left: 0; right: 0; top: 66%; align-items: center; }
.prompt-pill { flex-direction: row; align-items: center; height: 56px; padding: 0 32px; }
.prompt-text { font-size: 22px; -unity-font-definition: url("../../Fonts/Barlow-SemiBold.ttf"); }
.status { margin-top: 8px; padding: 6px 26px; }
.status-text { font-size: 18px; color: var(--dim); -unity-font-definition: url("../../Fonts/Barlow-SemiBold.ttf"); }
/* a held task: a bar in a navy frame */
.progress { width: 340px; height: 18px; margin-top: 12px; border-width: 3px; border-color: #051729; background-color: #051729; }
.progress-fill { height: 12px; width: 0%; background-color: var(--teal-l); }

/* ---------- flash (centre, above the prompt): a short shout on orange ---------- */
.flash { position: absolute; left: 0; right: 0; top: 56%; align-items: center; opacity: 0; transition: opacity 0.2s ease; }
.flash--show { opacity: 1; }
.flash-slab { padding: 2px 30px; }
.flash-text { font-size: 30px; letter-spacing: 1px; color: var(--navy); }
