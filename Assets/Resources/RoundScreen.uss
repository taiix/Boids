/* ============================================================
   REEF RUN — in-round screen (RoundScreen.cs)
   Role intro / wall-lifted banner, exit marker, spectate bar and
   the end-of-round results. Same palette as the lobby
   (ReefRunLobby.uss); variables don't cross UIDocuments, so the
   ones used here are redeclared on the root.
   ============================================================ */

.rs-root{
    --text:#eaf6f4; --dim:#88b4bd; --aqua:#3fe0c5; --shark:#ff5d6c; --amber:#ffc857;
    --glass:rgba(8,40,52,0.62); --border:rgba(99,200,210,0.22);
    position:absolute; left:0; top:0; right:0; bottom:0;
}

/* ---------- banner ---------- */
.rs-banner{ position:absolute; left:0; right:0; top:24%; align-items:center; opacity:0; }
.rs-eyebrow{
    font-size:15px; letter-spacing:7px; color:var(--aqua); -unity-text-align:middle-center;
    text-shadow:0 1px 4px rgba(0,0,0,0.9); margin-bottom:6px;
}
.rs-title{
    font-size:60px; -unity-font-style:bold; letter-spacing:4px; color:var(--text);
    -unity-text-align:middle-center; text-shadow:0 3px 10px rgba(0,0,0,0.85);
}
.rs-sub{
    font-size:21px; color:var(--text); margin-top:6px; -unity-text-align:middle-center;
    text-shadow:0 2px 6px rgba(0,0,0,0.9);
}
.rs-banner.fish .rs-eyebrow{ color:var(--aqua); }
.rs-banner.shark .rs-eyebrow{ color:var(--shark); }
.rs-banner.alert .rs-eyebrow{ color:var(--amber); }
.rs-banner.shark .rs-title{ color:#ffd9dc; }

/* ---------- exit marker ---------- */
.rs-marker{ position:absolute; align-items:center; translate:-50% -50%; }
.rs-diamond{
    width:18px; height:18px; rotate:45deg;
    border-width:2px; border-color:var(--amber); background-color:rgba(255,200,87,0.28);
}
.rs-marker-label{
    margin-top:9px; font-size:14px; letter-spacing:3px; color:var(--amber); -unity-font-style:bold;
    text-shadow:0 1px 4px rgba(0,0,0,0.95);
}

/* ---------- spectating ---------- */
.rs-spectate{ position:absolute; left:0; right:0; bottom:6%; align-items:center; }
.rs-spectate-card{
    align-items:center; padding:10px 26px 12px 26px; border-radius:8px;
    background-color:var(--glass); border-width:1px; border-color:var(--border);
}
.rs-spec-eyebrow{ font-size:11px; letter-spacing:5px; color:var(--dim); }
.rs-spec-name{ font-size:24px; -unity-font-style:bold; color:var(--text); margin-top:2px; }
.rs-spec-hint{ font-size:12px; color:var(--dim); margin-top:4px; letter-spacing:1px; }

/* ---------- caught: break free ---------- */
.rs-struggle{ position:absolute; left:0; right:0; top:64%; align-items:center; }
.rs-struggle-title{
    font-size:46px; -unity-font-style:bold; letter-spacing:5px; color:var(--shark);
    -unity-text-align:middle-center; text-shadow:0 3px 10px rgba(0,0,0,0.9);
}
.rs-struggle-key{
    font-size:20px; letter-spacing:4px; -unity-font-style:bold; color:var(--text); margin-top:2px;
    text-shadow:0 2px 6px rgba(0,0,0,0.9);
}
.rs-struggle-bar{
    width:540px; height:24px; margin-top:12px; border-radius:12px; overflow:hidden;
    background-color:rgba(3,16,24,0.75); border-width:2px; border-color:rgba(255,93,108,0.7);
    transition:scale 0.06s ease-out;
}
.rs-struggle.pressed .rs-struggle-bar{ scale:1.04 1.2; border-color:var(--aqua); }
.rs-struggle-fill{ height:100%; width:0%; background-color:var(--aqua); }
.rs-struggle-time{ width:540px; height:5px; margin-top:6px; border-radius:3px; background-color:rgba(255,93,108,0.25); }
.rs-struggle-time-fill{ height:100%; width:100%; border-radius:3px; background-color:var(--shark); }
.rs-struggle-sub{ font-size:15px; color:var(--text); margin-top:8px; text-shadow:0 1px 4px rgba(0,0,0,0.9); }

/* ---------- results ---------- */
.rs-results{
    position:absolute; left:0; top:0; right:0; bottom:0;
    align-items:center; justify-content:center;
    background-color:rgba(3,16,24,0.84);
    opacity:0; transition:opacity 0.6s ease-out;
}
.rs-results.shown{ opacity:1; }

.rs-card{
    width:960px; max-width:94%; align-items:center;
    padding:34px 40px 30px 40px; border-radius:10px;
    background-color:var(--glass); border-width:1px; border-color:var(--border);
}
.rs-res-eyebrow{ font-size:13px; letter-spacing:7px; color:var(--dim); }
.rs-res-title{ font-size:66px; -unity-font-style:bold; letter-spacing:5px; color:var(--text); margin-top:4px; }
.rs-res-title.fish{ color:var(--aqua); }
.rs-res-title.shark{ color:var(--shark); }
.rs-res-you{
    font-size:14px; letter-spacing:5px; -unity-font-style:bold; margin-top:6px;
    padding:4px 14px; border-radius:14px; border-width:1px;
}
.rs-res-you.won{ color:var(--aqua); border-color:var(--aqua); }
.rs-res-you.lost{ color:var(--shark); border-color:var(--shark); }
.rs-res-sub{ font-size:19px; color:var(--text); margin-top:14px; }

.rs-columns{ flex-direction:row; align-self:stretch; margin-top:24px; }
.rs-col{
    flex-grow:1; flex-basis:0; min-height:150px; margin:0 8px; padding:14px 18px;
    border-radius:6px; background-color:rgba(3,16,24,0.45);
    border-width:1px; border-color:rgba(99,200,210,0.14);
}
.rs-col-head{ font-size:12px; letter-spacing:4px; -unity-font-style:bold; margin-bottom:10px; color:var(--dim); }
.rs-col.escaped .rs-col-head{ color:var(--aqua); }
.rs-col.eaten .rs-col-head{ color:var(--shark); }
.rs-col.died .rs-col-head{ color:var(--amber); }
.rs-row{ flex-direction:row; align-items:center; margin:3px 0; }
.rs-dot{ width:8px; height:8px; border-radius:4px; margin-right:10px; background-color:var(--dim); }
.rs-col.escaped .rs-dot{ background-color:var(--aqua); }
.rs-col.eaten .rs-dot{ background-color:var(--shark); }
.rs-col.died .rs-dot{ background-color:var(--amber); }
.rs-row-name{ font-size:18px; color:var(--text); }
.rs-empty{ font-size:15px; color:var(--dim); -unity-font-style:italic; }

.rs-shark-line{ margin-top:18px; font-size:15px; letter-spacing:2px; color:var(--dim); }
.rs-left-line{ margin-top:6px; font-size:13px; color:var(--dim); }

.rs-buttons{ flex-direction:row; justify-content:center; margin-top:26px; }
.rs-btn{
    font-size:15px; letter-spacing:3px; -unity-font-style:bold;
    padding:12px 26px; margin:0 8px; border-radius:6px;
    color:var(--text); background-color:rgba(8,40,52,0.7);
    border-width:1px; border-color:rgba(99,200,210,0.35);
}
.rs-btn:hover{ border-color:var(--aqua); color:var(--aqua); }
.rs-btn.primary{ color:rgb(3,24,30); background-color:var(--aqua); border-color:var(--aqua); }
.rs-btn.primary:hover{ color:rgb(3,24,30); background-color:rgb(120,240,218); }
.rs-wait{ margin-top:14px; font-size:13px; color:var(--dim); }
