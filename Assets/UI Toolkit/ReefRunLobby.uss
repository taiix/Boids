/* ============================================================
   REEF RUN — lobby stylesheet (UI Toolkit / USS)
   ------------------------------------------------------------
   Engine notes (UI Toolkit can't do everything CSS can):
   - No backdrop blur  -> "frosted glass" = translucent dark panels.
   - No box-shadow      -> depth comes from borders + translucency.
   - No CSS gradients   -> stage gradient + glow is a baked texture
                           assigned in C# (ReefRunLobbyController).
   - No text-transform  -> uppercase text is written uppercase already.
   - No fl. gap         -> spacing uses margins.
   FONT: assign Bricolage Grotesque / Space Grotesk / Space Mono as
   FontAssets to the three classes below (-unity-font-definition) to
   match the mock. Without them the default font is used.
   ============================================================ */

:root{
    --text:#eaf6f4; --dim:#88b4bd; --aqua:#3fe0c5; --fish:#56d6b6;
    --shark:#ff5d6c; --blue:#6ea8ff;
    --glass:rgba(8,40,52,0.5); --glass-2:rgba(8,40,52,0.4);
    --border:rgba(99,200,210,0.18);
    --border-aqua:rgba(63,224,197,0.5);
}

/* font roles — point these at your imported FontAssets */
.display { /* -unity-font-definition: url("project://database/Assets/ReefRun/Fonts/BricolageGrotesque.asset"); */ }
.mono    { /* -unity-font-definition: url("project://database/Assets/ReefRun/Fonts/SpaceMono.asset"); */ }

.stage{
    flex-grow:1;
    /* background image (gradient + glow) is set from C# */
    -unity-background-scale-mode:scale-and-crop;
    color:var(--text);
}
.ambient-mount{ position:absolute; left:0; top:0; right:0; bottom:0; }

.ui{ position:absolute; left:0; top:0; right:0; bottom:0; flex-direction:column; padding:26px 28px; }

/* glass surface */
.glass{
    background-color:var(--glass);
    border-width:1px;
    border-color:var(--border);
}

/* ---------- header ---------- */
.header{ flex-direction:row; justify-content:space-between; align-items:center; margin-bottom:16px; }
.brand{ flex-direction:row; align-items:center; }
.emblem{
    width:46px; height:46px; align-items:center; justify-content:center;
    background-color:var(--glass); border-width:1px; border-color:var(--border);
    margin-right:14px;
}
.emblem-glyph{ color:var(--aqua); font-size:16px; }
.eyebrow{ -unity-font-style:normal; font-size:11px; letter-spacing:3px; color:var(--aqua); }
.title{ -unity-font-style:bold; font-size:34px; color:var(--text); margin-top:2px; }

.header-right{ flex-direction:row; align-items:center; }
.pill{
    flex-direction:row; align-items:center;
    padding:8px 14px; border-radius:999px;
    background-color:var(--glass); border-width:1px; border-color:var(--border);
    margin-left:10px;
}
.pill Label{ font-size:12px; letter-spacing:1px; }
.pill-dim{ color:var(--dim); }
.pill-strong{ color:var(--text); -unity-font-style:bold; }
.lobby-pill .pill-dim{ margin-left:1px; }
.live-dot{ width:8px; height:8px; border-radius:4px; background-color:var(--fish); margin-right:8px; }
.code{ color:var(--text); -unity-font-style:bold; letter-spacing:2px; margin:0 10px; }
.copy-btn{
    font-size:11px; letter-spacing:1px; color:var(--dim);
    background-color:rgba(0,0,0,0); border-width:1px; border-color:var(--border);
    padding:3px 9px; border-radius:3px;
}
.copy-btn:hover{ border-color:var(--border-aqua); color:var(--aqua); }
.copy-btn.copied{ border-color:var(--aqua); color:var(--aqua); }

/* ---------- body ---------- */
.body{ flex-direction:row; flex-grow:1; }
.roster-col{ flex-grow:1; flex-direction:column; padding:18px; margin-right:16px; }
.roster-head{ flex-direction:row; justify-content:space-between; align-items:center; margin-bottom:12px; }
.label{ font-size:11px; letter-spacing:2px; color:var(--dim); }
.roster-list{ flex-grow:1; }

/* a player row */
.row{
    flex-direction:row; align-items:center;
    padding:8px 12px; min-height:48px; margin-bottom:7px;
    background-color:var(--glass-2);
    border-width:1px; border-color:var(--border);
    transition: background-color 0.9s ease, border-color 0.9s ease;
}
.row.joined{
    background-color:rgba(63,224,197,0.16);
    border-color:var(--border-aqua);
    transition:none;            /* snap bright, then base transition fades back */
}
.avatar{
    width:34px; height:34px; border-radius:17px; margin-right:12px;
    align-items:center; justify-content:center;
    -unity-background-scale-mode:scale-and-crop;
}
.avatar Label{ color:#06283f; -unity-font-style:bold; font-size:12px; }
.who{ flex-grow:1; }
.name-line{ flex-direction:row; align-items:center; }
.name{ -unity-font-style:bold; font-size:15px; color:var(--text); }
.tag{
    font-size:9px; letter-spacing:1px; padding:1px 5px; margin-left:8px;
    border-width:1px; border-color:var(--border); color:var(--dim);
}
.tag-you{ color:var(--aqua); border-color:var(--border-aqua); }
.meta{ font-size:11px; color:var(--dim); margin-top:2px; letter-spacing:0.5px; }

.ready-state{ flex-direction:row; align-items:center; }
.checkbox{ width:16px; height:16px; border-width:1px; border-color:rgba(99,200,210,0.4); margin-right:8px; }
.checkbox.on{ background-color:var(--aqua); border-color:var(--aqua); }
.rlabel{ font-size:11px; letter-spacing:1px; color:var(--dim); }
.rlabel.ready{ color:var(--fish); }

/* open slot */
.row-open{
    flex-direction:row; align-items:center; justify-content:center;
    padding:8px 12px; min-height:48px; margin-bottom:7px;
    background-color:rgba(0,0,0,0);
    border-width:1px; border-color:rgba(99,200,210,0.22);
    /* dashed not supported everywhere; reads as a quiet hollow row */
    color:var(--dim); font-size:12px; letter-spacing:0.5px;
}
.row-open:hover{ border-color:var(--border-aqua); }
.row-open Label{ color:var(--dim); }
.row-open:hover Label{ color:var(--aqua); }
.ghost-av{ width:34px; height:34px; border-radius:17px; border-width:1px; border-color:rgba(99,200,210,0.3); margin-right:11px; }

/* ---------- side ---------- */
.side-col{ width:360px; flex-direction:column; }
.shark-card{ padding:17px; margin-bottom:16px; border-left-width:2px; border-left-color:rgba(255,93,108,0.55); }
.card-head{ flex-direction:row; align-items:center; margin-bottom:13px; }
.card-title{ -unity-font-style:bold; font-size:18px; color:var(--text); }
.dot-shark{ width:9px; height:9px; border-radius:5px; background-color:var(--shark); margin-right:9px; }
.chips{ flex-direction:row; flex-wrap:wrap; margin-bottom:12px; min-height:30px; }
.chip{
    width:30px; height:30px; border-radius:15px; border-width:2px;
    align-items:center; justify-content:center; margin-right:7px; margin-bottom:7px;
}
.chip Label{ -unity-font-style:bold; font-size:13px; }
.shark-copy{ font-size:13px; color:var(--dim); white-space:normal; }

.activity-card{ padding:17px; flex-grow:1; flex-direction:column; }
.feed{ flex-grow:1; margin-top:2px; }
.feed-line{ flex-direction:row; align-items:center; margin-bottom:10px; }
.feed-dot{ width:7px; height:7px; border-radius:4px; margin-right:10px; }
.feed-text{ flex-grow:1; font-size:13px; color:var(--text); white-space:normal; }
.feed-time{ font-size:10px; letter-spacing:1px; color:var(--dim); margin-left:8px; }

/* ---------- footer ---------- */
.footer{ flex-direction:row; align-items:center; padding:15px 20px; margin-top:16px; }
.ready-wrap{ flex-grow:1; margin-right:26px; }
.ready-row{ flex-direction:row; align-items:center; margin-bottom:9px; }
.ready-count{ font-size:12px; letter-spacing:1px; color:var(--text); margin-left:10px; }
.bar{ height:3px; background-color:rgba(99,200,210,0.15); }
.bar-fill{ height:3px; width:0%; background-color:var(--aqua); transition: width 0.45s ease; }
.actions{ flex-direction:row; align-items:center; }

.btn{
    font-size:14px; letter-spacing:0.4px; -unity-font-style:bold;
    padding:11px 20px; margin-left:10px; border-width:1px; border-radius:3px;
    border-color:rgba(0,0,0,0);
}
.btn-sm{ padding:7px 13px; font-size:12px; margin-left:0; }
.btn-aqua{ background-color:var(--aqua); color:#06283f; border-color:var(--aqua); }
.btn-aqua:hover{ background-color:rgb(95,240,214); }
.btn-ghost{ background-color:var(--glass-2); color:var(--text); border-color:var(--border); }
.btn-ghost:hover{ border-color:var(--border-aqua); color:var(--aqua); }
.btn-blue{ background-color:var(--blue); color:#06283f; border-color:var(--blue); }
.btn-blue:hover{ background-color:rgb(134,184,255); }
.btn:disabled{ opacity:0.38; }

/* ---------- overlay ---------- */
.overlay{
    position:absolute; left:0; top:0; right:0; bottom:0;
    align-items:center; justify-content:center;
    background-color:rgba(3,16,24,0.92);
    opacity:0; transition: opacity 0.6s ease;
}
.overlay.show{ opacity:1; }
.ov-inner{ align-items:center; }
.ov-eyebrow{ font-size:12px; letter-spacing:6px; color:var(--aqua); margin-bottom:18px; }
.ov-title-row{ flex-direction:row; align-items:center; }
.ov-title{ -unity-font-style:bold; font-size:60px; letter-spacing:5px; color:var(--text); }
.ov-dots{ flex-direction:row; align-items:center; margin-left:14px; }
.ov-dot{ width:9px; height:9px; border-radius:5px; background-color:var(--aqua); margin-left:7px; opacity:0.3; }
.ov-line{ margin-top:22px; opacity:0; transition: opacity 0.6s ease; }
.ov-line-1{ font-size:22px; color:var(--text); }
.ov-line-2{ font-size:15px; color:var(--dim); margin-top:12px; }
.overlay.phase1 .ov-line-1{ opacity:1; }
.overlay.phase2 .ov-line-2{ opacity:1; }

:focus{ }   /* focus ring handled by panel default */
