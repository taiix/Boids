/* ============================================================
   REEF RUN — main menu ("inside the mouth")
   The background is the live 3D menu scene (MenuSharkCruise: the
   camera rides in the shark's mouth while it swims the reef), so the
   stage is transparent. The top/bottom shades are baked gradient
   textures set from ReefRunMainMenuController.
   Palette = the game's own UI (see ReefRunLobby.uss).
   ============================================================ */

:root {
    --navy: #051729;
    --teal: #179499;
    --teal-l: #2cc3c4;
    --orange: #ffb84d;
    --text: #eef6f7;
    --dim:  #8fb0bb;
    --line: rgba(143, 176, 187, 0.18);
    /* names kept for the shared settings overlay below */
    --aqua: #2cc3c4;
    --glass: rgba(5, 23, 41, 0.97);
    --border: rgba(143, 176, 187, 0.18);
    --border-aqua: rgba(44, 195, 196, 0.5);
}

.mm-stage { flex-grow: 1; color: var(--text); font-size: 16px; -unity-font-definition: url("Fonts/Barlow-Regular.ttf"); }
/* covers the 3D view until the reef backdrop has loaded, then fades away */
.mm-veil { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: #030c16; transition: opacity 1.6s ease-in-out; }
.mm-veil--hidden { opacity: 0; }
.mm-shade { position: absolute; left: 0; right: 0; -unity-background-scale-mode: stretch-to-fill; }
.mm-shade--top { top: 0; height: 62%; }
.mm-shade--bottom { bottom: 0; height: 30%; }
.mm-ui { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.mm-ui Label { padding: 0; margin: 0; }

/* ---------- centre block ---------- */
.mm-center { position: absolute; left: 0; right: 0; top: 110px; align-items: center; }
.mm-eyebrow { font-size: 17px; letter-spacing: 6px; color: var(--orange); -unity-font-definition: url("Fonts/BarlowCondensed-Bold.ttf"); }
.mm-logo { flex-direction: row; margin-top: 2px; }
.mm-logo-word { font-size: 190px; letter-spacing: -2px; color: var(--text); -unity-font-definition: url("Fonts/BarlowCondensed-ExtraBoldItalic.ttf");
                text-shadow: 0 8px 40px rgba(0, 0, 0, 0.55); }
.mm-logo-word--run { color: var(--teal-l); margin-left: 36px; }
.mm-tagline { font-size: 22px; color: #cfe3e8; margin-top: -4px; }
.mm-tagline-strong { -unity-font-definition: url("Fonts/Barlow-Bold.ttf"); color: #ffffff; }

.mm-nav { flex-direction: row; margin-top: 38px; }
.mm-nav-btn { height: 70px; min-width: 190px; margin: 0 7px; padding: 0 30px; border-radius: 12px;
              background-color: rgba(5, 23, 41, 0.86); border-width: 1px; border-color: var(--line);
              color: rgba(238, 246, 247, 0.88); font-size: 28px; letter-spacing: 3px;
              -unity-font-definition: url("Fonts/BarlowCondensed-ExtraBold.ttf");
              transition: background-color 0.12s ease, border-color 0.12s ease, color 0.12s ease, scale 0.12s ease; }
.mm-nav-btn:hover, .mm-nav-btn:focus { background-color: var(--orange); border-color: var(--orange); color: var(--navy); scale: 1.04 1.04; }
.mm-nav-btn:active { scale: 0.98 0.98; }
.mm-hint { font-size: 16px; color: var(--dim); margin-top: 16px; }

/* ---------- friends on the reef (bottom-left chips) ---------- */
.mm-friends { position: absolute; left: 56px; bottom: 48px; flex-direction: row; }
.mm-chip { flex-direction: row; align-items: center; height: 54px; padding: 0 14px 0 6px; margin-right: 10px; border-radius: 12px;
           background-color: rgba(5, 23, 41, 0.86); border-width: 1px; border-color: var(--line); }
.mm-chip-av { width: 40px; height: 40px; border-radius: 8px; margin-right: 10px; -unity-background-scale-mode: scale-and-crop;
              background-color: rgba(143, 176, 187, 0.15); }
.mm-chip-name { font-size: 15px; -unity-font-definition: url("Fonts/Barlow-Bold.ttf"); }
.mm-chip-status { font-size: 12.5px; color: var(--teal-l); }
.mm-chip-status--game { color: #7fb2ff; }
.mm-chip-join { height: 34px; margin: 0 0 0 10px; padding: 0 12px; border-radius: 8px; border-width: 0;
                background-color: var(--orange); color: var(--navy); font-size: 16px; letter-spacing: 2px;
                -unity-font-definition: url("Fonts/BarlowCondensed-ExtraBold.ttf"); }
.mm-chip-join:hover { background-color: #ffc56b; }

/* ---------- player pill (bottom-right) + version ---------- */
.mm-player-card { position: absolute; right: 56px; bottom: 48px; flex-direction: row; align-items: center; height: 58px;
                  padding: 0 18px 0 7px; border-radius: 12px; background-color: rgba(5, 23, 41, 0.86);
                  border-width: 1px; border-color: var(--line); }
.mm-player-av { width: 44px; height: 44px; border-radius: 9px; margin-right: 12px; -unity-background-scale-mode: scale-and-crop;
                background-color: rgba(143, 176, 187, 0.15); }
.mm-player-name { font-size: 16px; -unity-font-definition: url("Fonts/Barlow-Bold.ttf"); }
.mm-player-sub { font-size: 12.5px; color: var(--teal-l); }
.mm-version { position: absolute; right: 60px; top: 44px; font-size: 15px; letter-spacing: 3px; color: rgba(143, 176, 187, 0.7);
              -unity-font-definition: url("Fonts/BarlowCondensed-Bold.ttf"); }

/* ============================================================
   SHARED UTILITIES (used by the settings overlay)
   ============================================================ */

.mm-glass {
    background-color: var(--glass);
    border-width: 1px;
    border-color: var(--border);
}

.mm-btn {
    font-size: 14px;
    letter-spacing: 0.4px;
    -unity-font-style: bold;
    padding: 11px 28px;
    border-width: 1px;
    border-radius: 3px;
    border-color: rgba(0,0,0,0);
    margin: 0;
}
.mm-btn-aqua { background-color: var(--orange); color: #051729; border-color: var(--orange); }
.mm-btn-aqua:hover { background-color: #ffc56b; }

/* ============================================================
   SETTINGS OVERLAY
   ============================================================ */

.mm-settings-overlay {
    -unity-font-definition: url("Fonts/Barlow-Regular.ttf");
    color: var(--text);
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(3,10,16,0.88);
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.22s ease;
}
.mm-settings-overlay.show { opacity: 1; }

/* card */
.mm-settings-card {
    width: 1000px;
    flex-direction: column;
    padding: 28px;
    border-radius: 4px;
}

/* header row */
.mm-settings-head {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 22px;
}

.mm-settings-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--text);
    letter-spacing: 4px;
}

.mm-close-btn {
    background-color: rgba(0,0,0,0);
    border-width: 1px;
    border-color: var(--border);
    border-radius: 3px;
    color: var(--dim);
    font-size: 13px;
    padding: 4px 10px;
}
.mm-close-btn:hover { border-color: var(--border-aqua); color: var(--text); }

/* section dividers */
.mm-section-label {
    font-size: 10px;
    letter-spacing: 3px;
    color: var(--dim);
    margin-top: 14px;
    margin-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: var(--border);
    padding-bottom: 6px;
}

/* setting row */
.mm-setting-row {
    flex-direction: row;
    align-items: center;
    min-height: 40px;
    margin-bottom: 4px;
}

.mm-setting-name {
    width: 110px;
    font-size: 13px;
    color: var(--text);
    flex-shrink: 0;
}

/* ---- sliders ---- */
.mm-slider {
    flex-grow: 1;
    margin: 0 10px;
}

.mm-slider .unity-base-slider__drag-container {
    height: 20px;
}

.mm-slider .unity-base-slider__tracker {
    background-color: rgba(99,200,210,0.20);
    height: 3px;
    border-width: 0;
    border-radius: 2px;
}

.mm-slider .unity-base-slider__dragger {
    width: 14px;
    height: 14px;
    border-radius: 7px;
    background-color: var(--aqua);
    border-width: 0;
}
.mm-slider .unity-base-slider__dragger:hover { background-color: rgb(95,240,214); }

.mm-setting-val {
    width: 42px;
    font-size: 12px;
    color: var(--dim);
    -unity-text-align: middle-right;
    letter-spacing: 0.5px;
    flex-shrink: 0;
}

/* ---- dropdowns ---- */
.mm-dropdown {
    flex-grow: 1;
    margin: 0;
}

.mm-dropdown .unity-base-field__label { display: none; }

.mm-dropdown .unity-dropdown-field__input,
.mm-dropdown .unity-base-popup-field__input {
    background-color: rgba(8,40,52,0.8);
    border-width: 1px;
    border-color: var(--border);
    border-radius: 3px;
    padding: 8px 12px;
    flex-grow: 1;
}
.mm-dropdown .unity-dropdown-field__input:hover,
.mm-dropdown .unity-base-popup-field__input:hover { border-color: var(--border-aqua); }

.mm-dropdown .unity-base-dropdown__label,
.mm-dropdown .unity-base-popup-field__text {
    color: var(--text);
    font-size: 13px;
    flex-grow: 1;
}
.mm-dropdown .unity-dropdown-field__arrow,
.mm-dropdown .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: var(--dim);
    width: 12px;
    height: 12px;
}

/* ---- toggles (pill switch style) ---- */
.mm-toggle {
    flex-grow: 1;
    justify-content: flex-end;
    flex-direction: row;
    margin: 0;
}
.mm-toggle .unity-toggle__label { display: none; }

.mm-toggle .unity-toggle__input {
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: 40px;
    min-width: 40px;
    width: 40px;
    height: 22px;
    border-radius: 11px;
    background-color: rgba(99,200,210,0.15);
    border-width: 1px;
    border-color: var(--border);
    align-items: flex-start;
    justify-content: center;
    padding: 3px;
    flex-shrink: 0;
    transition: background-color 0.15s ease, border-color 0.15s ease;
}
.mm-toggle .unity-toggle__input:checked {
    background-color: var(--aqua);
    border-color: var(--aqua);
}

.mm-toggle .unity-toggle__checkmark {
    width: 14px;
    height: 14px;
    border-radius: 7px;
    background-color: var(--dim);
    background-image: none;
    border-width: 0;
    translate: 0 0;
    transition: translate 0.15s ease, background-color 0.15s ease;
}
.mm-toggle .unity-toggle__input:checked .unity-toggle__checkmark {
    background-color: #06283f;
    translate: 17px 0;
}

/* ---- settings footer ---- */
.mm-settings-foot {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 18px;
    padding-top: 14px;
    border-top-width: 1px;
    border-top-color: var(--border);
}

/* ---- two columns: audio + display | microphone ---- */
.mm-settings-cols { flex-direction: row; }
.mm-settings-col { flex-grow: 1; flex-basis: 0; flex-direction: column; }
.mm-settings-col--right { margin-left: 40px; }

/* ---- microphone ---- */
/* the meter and the Sensitivity slider share one scale (-60..0 dB), so the orange marker sits where
   the level has to reach before your voice is sent */
.mm-meter {
    flex-grow: 1;
    height: 10px;
    margin: 0 10px;
    border-radius: 5px;
    background-color: rgba(143, 176, 187, 0.15);
}
.mm-meter-fill {
    position: absolute; left: 0; top: 0; bottom: 0;
    width: 0%;
    border-radius: 5px;
    background-color: rgba(143, 176, 187, 0.6);
}
.mm-meter-fill--loud { background-color: var(--aqua); }
.mm-meter-mark {
    position: absolute; top: -5px; bottom: -5px;
    left: 39%;
    width: 2px;
    margin-left: -1px;
    background-color: var(--orange);
}
.mm-mic-status {
    flex-direction: row;
    align-items: flex-start;
    margin-top: 10px;
    padding: 10px 12px;
    border-radius: 8px;
    background-color: rgba(2, 10, 18, 0.55);
    border-width: 1px;
    border-color: var(--border);
}
.mm-mic-dot { width: 10px; height: 10px; border-radius: 5px; margin: 4px 10px 0 0; flex-shrink: 0; background-color: var(--dim); }
.mm-mic-dot--ok { background-color: #2cc3c4; }
.mm-mic-dot--warn { background-color: #e6b333; }
.mm-mic-dot--bad { background-color: #d94040; }
.mm-mic-status-text { flex-grow: 1; flex-shrink: 1; font-size: 13px; color: var(--text); white-space: normal; padding: 0; margin: 0; }
.mm-mic-note { font-size: 12px; color: var(--dim); margin-top: 12px; white-space: normal; padding: 0; }
.mm-link-btn {
    align-self: flex-start;
    margin: 8px 0 0 0;
    padding: 8px 14px;
    border-radius: 8px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: var(--border-aqua);
    color: var(--aqua);
    font-size: 13px;
}
.mm-link-btn:hover { background-color: rgba(44, 195, 196, 0.12); }

/* ============================================================
   LOBBY BROWSER (JOIN) - built by ReefRunLobbyBrowser, reuses the chip avatar/name/JOIN styles
   ============================================================ */
.mm-lb-status { font-size: 14px; color: var(--dim); margin-bottom: 12px; white-space: normal; }
.mm-lb-row { flex-direction: row; align-items: center; height: 62px; padding: 0 12px 0 10px; margin-bottom: 8px; border-radius: 10px;
             background-color: rgba(2, 10, 18, 0.55); border-width: 1px; border-color: var(--border); }
.mm-lb-row:hover { border-color: var(--border-aqua); }
.mm-lb-tag { font-size: 11px; letter-spacing: 1.5px; padding: 1px 6px; margin-left: 8px; border-radius: 4px;
             background-color: var(--teal); color: #ffffff; -unity-font-definition: url("Fonts/BarlowCondensed-Bold.ttf"); }
.mm-lb-count { font-size: 20px; letter-spacing: 1px; color: var(--text); margin: 0 6px 0 12px;
               -unity-font-definition: url("Fonts/BarlowCondensed-Bold.ttf"); }
.mm-lb-foot { font-size: 12px; color: var(--dim); margin-top: 12px; padding-top: 12px;
              border-top-width: 1px; border-top-color: var(--border); }
